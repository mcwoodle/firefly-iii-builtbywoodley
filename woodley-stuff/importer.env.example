# Firefly III Data Importer — env for the rootless podman container.
# Installed by woodley-stuff/firefly-importer-setup.sh to
# ~/.config/firefly-importer/importer.env (mode 600, NOT in git: it may hold a token).
# Full upstream reference: https://github.com/firefly-iii/data-importer/blob/main/.env.example

# URL the *container* uses to call the Firefly III API. Firefly runs on the host
# (nginx :6560, see README.md). Under podman's default pasta networking the
# container is handed the host's own LAN IP, so http://192.168.0.238:6560 would
# loop back into the container — use the host alias instead.
FIREFLY_III_URL=http://host.containers.internal:6560

# URL the *browser* uses for Firefly III (OAuth redirects go here).
VANITY_URL=http://192.168.0.238:6560

# URL the browser uses for the importer itself.
APP_URL=http://192.168.0.238:8081

# Auth — pick one (Firefly → Profile → OAuth):
# - Client ID (what upstream's guide uses): create an OAuth Client with callback
#   http://192.168.0.238:8081/callback and "Confidential" UNCHECKED. Leave
#   FIREFLY_III_CLIENT_ID empty and the importer asks for the ID in the browser.
# - Personal Access Token: env-only (the browser form has no field for it).
#   Create one under Personal Access Tokens and paste it below; then
#   `systemctl --user restart firefly-importer`.
FIREFLY_III_ACCESS_TOKEN=
FIREFLY_III_CLIENT_ID=

TZ=America/Toronto
TRUSTED_PROXIES=
LOG_LEVEL=info

# Directory import: uncomment the Volume= line in firefly-importer.container too.
# The path *inside* the container is /import; keep the host dir outside this
# checkout so the :Z relabel can't break nginx (see README "Gotcha").
#IMPORT_DIR_ALLOWLIST=/import
